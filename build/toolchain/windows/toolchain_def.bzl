"""What a Windows target architecture's cc_toolchain looks like.

The counterpart of build/toolchain/toolchain_def.bzl and
build/toolchain/macos/toolchain_def.bzl: the rules each architecture needs
(platform, cc_toolchain_config, cc_toolchain, toolchain) differ only in the
values windows_cc_toolchain takes, the compiler flags come from this
directory's compiler_flags.bzl and the SDK and libc++ ones from its
toolchain_flags.bzl. Built on the Linux x64 host, as a cross build, the way
Chromium cross-builds Windows.

The config is rules_cc's own windows_cc_toolchain_config, the one Bazel uses
for clang-cl on Windows: it emits MSVC-style command lines for clang-cl,
lld-link and llvm-lib exactly as for cl/link/lib. It lives under rules_cc's
private/ tree; rules_cc is pinned in MODULE.bazel, so its shape cannot move
under this file unnoticed.

Adding an architecture: entries in setup_toolchain_windows.sh's
arch_windows_target and arch_xwin_arch, one line in BUILD.bazel's table, and
one more name in .bazelrc's build:windows --extra_toolchains.
"""

load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
load("@rules_cc//cc/toolchains:feature.bzl", "cc_feature")
load(
    "@rules_cc//cc/private/toolchain:windows_cc_toolchain_config.bzl",
    "cc_toolchain_config",
)
load(":compiler_flags.bzl", "COMPILE_FLAGS", "CXX_FLAGS", "LINK_FLAGS")
load(":toolchain_paths.bzl", "TOOLCHAIN_PREFIX", "WIN32_WINNT", "WINDOWS_MIN_VERSION", "WINDOWS_TARGETS")
load(
    ":toolchain_flags.bzl",
    "SDK_INCLUDE_DIRS",
    "libcxx_compile_flags",
    "libcxx_link_flags",
    "libcxx_link_libs",
    "sysroot_compile_flags",
    "sysroot_link_flags",
)

# Linux's -c opt flags (_OPT_COMPILE_FLAGS and _OPT_LINK_FLAGS in
# build/toolchain/toolchain_def.bzl), item for item, as clang-cl and lld-link
# spell them.
#
# Compile:
#   -g0                        -> nothing: no debug info unless asked for
#   -O2                        -> /O2, from rules_cc's own `opt` feature
#   -D_FORTIFY_SOURCE=1        -> nothing: a libc mechanism; the CRT has no
#                                 counterpart
#   -DNDEBUG                   -> /DNDEBUG
#   -ffunction-sections        -> /Gy
#   -fdata-sections            -> /Gw
_OPT_COMPILE_FLAGS = [
    "/DNDEBUG",
    "/Gy",
    "/Gw",
]

# Link:
#   --gc-sections              -> /OPT:REF
#   -z pack-relative-relocs    -> nothing: COFF base relocations are
#                                 already a compact page-grouped table
#   --icf=safe                 -> /OPT:SAFEICF. clang-cl emits the
#                                 address-significance table for COFF by
#                                 default, which safe ICF relies on.
#   -O2 (string tail merging)  -> /OPT:LLDTAILMERGE
_OPT_LINK_FLAGS = [
    "/OPT:REF",
    "/OPT:SAFEICF",
    "/OPT:LLDTAILMERGE",
]

def windows_cc_toolchain(arch, cpu, bazel_cpu, machine, clang_builtin_includes, tool_paths):
    """Defines the platform + toolchain quartet for one Windows architecture.

    Args:
      arch: this repo's short name for the architecture (x64). Keys
        WINDOWS_TARGETS and names the libc++ directory
        setup_toolchain_windows.sh installs, so it has to match that
        script's arch_windows_target(). Also names every rule defined here.
      cpu: the value for cc_toolchain_config's `cpu` attribute, which
        rules_cc's Windows config requires to be one of its own
        (x64_windows, arm64_windows). Also the --cpu the platform sets.
      bazel_cpu: the @platforms//cpu: constraint this architecture selects on.
      machine: lld-link's /MACHINE: for this architecture.
      clang_builtin_includes: shared clang resource-dir include paths, to
        which this function appends the per-arch libc++ one and the SDK's.
      tool_paths: the shared LLVM tools, keyed cl/link/lib/ml.
    """

    # Indexed, not .get(): a missing entry means toolchain_paths.bzl was
    # generated by an older setup_toolchain_windows.sh.
    target = WINDOWS_TARGETS[arch]

    # The compiler half of the target: the architecture, and the oldest
    # Windows the headers may assume (rules_cc adds the matching
    # _WIN32_WINNT from win32_winnt_flag below).
    target_flags = [
        "--target=" + target,
        "/DWINVER=" + WIN32_WINNT,
    ]

    # The linker half: the architecture, and the oldest Windows the image
    # declares it runs on (its subsystem version).
    link_target_flags = [
        "/MACHINE:" + machine,
        "/SUBSYSTEM:CONSOLE," + WINDOWS_MIN_VERSION,
    ]

    # --cpu as well, which constraints do not set: rules_cc's Windows config
    # and googleurl's BUILD files (a config_setting on cpu) tell Windows
    # apart by it, and it keeps each architecture's outputs in their own
    # bazel-out directory. Set here so that it follows --platforms.
    native.platform(
        name = "windows_" + arch,
        constraint_values = [
            "@platforms//os:windows",
            "@platforms//cpu:" + bazel_cpu,
        ],
        flags = ["--cpu=" + cpu],
    )

    # rules_cc's Windows config takes no opt_compile_flags/opt_link_flags as
    # its Unix one does, so the opt flags are a feature conditioned on
    # Bazel's own `opt`, enabled below. Its built-in smaller_binary, which
    # hard-codes the aggressive /OPT:ICF, is turned off in .bazelrc instead.
    cc_args(
        name = arch + "_opt_compile_args",
        actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
        args = _OPT_COMPILE_FLAGS,
        requires_any_of = ["@rules_cc//cc/toolchains/features:opt"],
    )
    cc_args(
        name = arch + "_opt_link_args",
        actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
        args = _OPT_LINK_FLAGS,
        requires_any_of = ["@rules_cc//cc/toolchains/features:opt"],
    )
    cc_feature(
        name = arch + "_opt_flags",
        args = [
            ":" + arch + "_opt_compile_args",
            ":" + arch + "_opt_link_args",
        ],
        feature_name = "quictun_opt_flags",
    )

    cc_toolchain_config(
        name = arch + "_config",
        toolchain_identifier = "chromium-clang-windows-" + arch,
        host_system_name = "x86_64-unknown-linux-gnu",
        target_system_name = target,
        cpu = cpu,
        target_libc = "msvcrt",
        compiler = "clang-cl",
        abi_version = "clang",
        abi_libc_version = "msvcrt",
        msvc_cl_path = tool_paths["cl"],
        msvc_link_path = tool_paths["link"],
        msvc_lib_path = tool_paths["lib"],
        msvc_ml_path = tool_paths["ml"],
        # Every include and library directory is an explicit flag below.
        # rules_cc requires these environment values to be non-empty, so
        # each names one directory those flags already name, adding nothing
        # (one each, since clang-cl and lld-link do not agree on a path-list
        # separator on a Linux host).
        msvc_env_include = SDK_INCLUDE_DIRS[0],
        msvc_env_lib = sysroot_link_flags(arch)[0].removeprefix("/LIBPATH:"),
        msvc_env_path = "/usr/bin:/bin",
        msvc_env_tmp = "/tmp",
        tool_paths = {},
        win32_winnt_flag = "/D_WIN32_WINNT=" + WIN32_WINNT,
        default_compile_flags = target_flags +
                                sysroot_compile_flags() +
                                libcxx_compile_flags(arch) +
                                COMPILE_FLAGS,
        cxx_flags = CXX_FLAGS,
        # /OPT:REF on every link, the linker half of COMPILE_FLAGS' /Gy, as
        # Linux has --gc-sections. With it lld-link would also fold identical
        # code aggressively unless told otherwise, which Linux does not do
        # outside -c opt: /OPT:NOICF, which _OPT_LINK_FLAGS raises to
        # SAFEICF. The libraries come last, as link_libs does on Linux.
        default_link_flags = link_target_flags +
                             sysroot_link_flags(arch) +
                             libcxx_link_flags(arch) +
                             LINK_FLAGS +
                             ["/OPT:REF", "/OPT:NOICF"] +
                             libcxx_link_libs(),
        archiver_flags = ["/MACHINE:" + machine],
        supports_parse_showincludes = True,
        extra_enabled_features = [":" + arch + "_opt_flags"],
        # Exactly the places a header may come from: clang's own resource
        # dir, the from-source libc++, and the SDK and CRT.
        cxx_builtin_include_directories = clang_builtin_includes + [
            "%s/libcxx-windows-%s/include/c++/v1" % (TOOLCHAIN_PREFIX, arch),
        ] + SDK_INCLUDE_DIRS,
    )

    native.cc_toolchain(
        name = arch + "_toolchain",
        toolchain_identifier = "chromium-clang-windows-" + arch,
        toolchain_config = ":" + arch + "_config",
        all_files = ":empty",
        ar_files = ":empty",
        as_files = ":empty",
        compiler_files = ":empty",
        dwp_files = ":empty",
        linker_files = ":empty",
        objcopy_files = ":empty",
        strip_files = ":empty",
        supports_param_files = 0,
    )

    native.toolchain(
        name = arch + "_cc_toolchain",
        exec_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
        ],
        target_compatible_with = [
            "@platforms//os:windows",
            "@platforms//cpu:" + bazel_cpu,
        ],
        toolchain = ":" + arch + "_toolchain",
        toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    )

    cpu = "aarch64",
    target_libc = "glibc_unknown",
    compiler = "clang",
    abi_version = "clang",
    abi_libc_version = "glibc_unknown",
    tool_paths = LLVM_TOOL_PATHS,
    compile_flags = [
        "--target=aarch64-unknown-linux-gnu",
    ] + libcxx_compile_flags("arm64"),
    link_flags = [
        "--target=aarch64-unknown-linux-gnu",
    ] + libcxx_link_flags("arm64"),
    link_libs = libcxx_link_libs(),
    archive_flags = [],
    unfiltered_compile_flags = ["-no-canonical-prefixes"],
    opt_compile_flags = [
        "-g0",
        "-O2",
        "-D_FORTIFY_SOURCE=1",
        "-DNDEBUG",
        "-ffunction-sections",
        "-fdata-sections",
    ],
    opt_link_flags = ["-Wl,--gc-sections"],
    dbg_compile_flags = ["-g"],
    cxx_builtin_include_directories = CLANG_BUILTIN_INCLUDES + [
        "/opt/libcxx-arm64/include/c++/v1",
        "/usr/aarch64-linux-gnu/include",
        "/usr/include",
    ],
)

cc_toolchain(
    name = "aarch64_toolchain",
    toolchain_identifier = "chromium-clang-aarch64-linux-gnu",
    toolchain_config = ":aarch64_config",
    all_files = ":empty",
    ar_files = ":empty",
    as_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 0,
)

toolchain(
    name = "aarch64_clang_cc_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    toolchain = ":aarch64_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)


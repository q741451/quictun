# --- mipsel (little-endian MIPS) ---
#
# Plain big-endian "mips" is deliberately not built for at all: quiche's
# own README states it only supports little-endian platforms, which is a
# correctness concern (silently wrong wire-format/crypto handling on a
# mismatched byte order), not just a build-break one.

platform(
    name = "linux_mipsel",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:mips32",
    ],
)

cc_toolchain_config(
    name = "mipsel_config",
    toolchain_identifier = "chromium-clang-mipsel-linux-gnu",
    host_system_name = "x86_64-unknown-linux-gnu",
    target_system_name = "mipsel-unknown-linux-gnu",
    cpu = "mipsel",
    target_libc = "glibc_unknown",
    compiler = "clang",
    abi_version = "clang",
    abi_libc_version = "glibc_unknown",
    tool_paths = LLVM_TOOL_PATHS,
    compile_flags = [
        "--target=mipsel-unknown-linux-gnu",
    ] + libcxx_compile_flags("mipsel"),
    link_flags = [
        "--target=mipsel-unknown-linux-gnu",
    ] + libcxx_link_flags("mipsel", mips_runtime = True),
    link_libs = libcxx_link_libs(mips_runtime = True),
    archive_flags = [],
    unfiltered_compile_flags = ["-no-canonical-prefixes"],
    opt_compile_flags = [
        "-g0",
        "-O2",
        "-D_FORTIFY_SOURCE=1",
        "-DNDEBUG",
        "-ffunction-sections",
        "-fdata-sections",
    ],
    opt_link_flags = ["-Wl,--gc-sections"],
    dbg_compile_flags = ["-g"],
    cxx_builtin_include_directories = CLANG_BUILTIN_INCLUDES + [
        "/opt/libcxx-mipsel/include/c++/v1",
        "/usr/mipsel-linux-gnu/include",
        "/usr/include",
    ],
)

cc_toolchain(
    name = "mipsel_toolchain",
    toolchain_identifier = "chromium-clang-mipsel-linux-gnu",
    toolchain_config = ":mipsel_config",
    all_files = ":empty",
    ar_files = ":empty",
    as_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 0,
)

toolchain(
    name = "mipsel_clang_cc_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:mips32",
    ],
    toolchain = ":mipsel_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

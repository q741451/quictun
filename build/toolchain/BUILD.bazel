    ] + sysroot_flags("arm64") + libcxx_compile_flags("arm64"),
    link_flags = [
        "--target=aarch64-linux-musl",
    ] + sysroot_flags("arm64") + libcxx_link_flags("arm64"),
    link_libs = libcxx_link_libs(),
    archive_flags = [],
    unfiltered_compile_flags = ["-no-canonical-prefixes"],
    opt_compile_flags = [
        "-g0",
        "-O2",
        "-D_FORTIFY_SOURCE=1",
        "-DNDEBUG",
        "-ffunction-sections",
        "-fdata-sections",
    ],
    opt_link_flags = ["-Wl,--gc-sections"],
    dbg_compile_flags = ["-g"],
    cxx_builtin_include_directories = CLANG_BUILTIN_INCLUDES + [
        TOOLCHAIN_PREFIX + "/libcxx-arm64/include/c++/v1",
        TOOLCHAIN_PREFIX + "/musl-arm64/include",
    ],

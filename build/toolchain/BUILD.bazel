# A from-scratch, pinned, Chromium-style cc_toolchain for all four
# architectures this project builds for (x86_64, aarch64, armv7, mipsel).
#
# This intentionally does NOT use Ubuntu's system/apt clang or gcc-*-cross
# packages as the compiler. Those drift across Ubuntu releases in ways
# that are invisible until they aren't: this project's mipsel toolchain
# broke once already because the GCC bundled with Ubuntu's mipsel cross
# package (GCC 10 on the Ubuntu release used for local dev) didn't support
# a C++20 constexpr std::vector that GCC 11+ does, and the real GitHub
# Actions runner (a different, newer Ubuntu release) silently had a
# different GCC version than local testing did.
#
# Chromium avoids this class of problem entirely by never depending on
# the host OS's own toolchain: it downloads a specific, hash-identified
# prebuilt clang (pinned in tools/clang/scripts/update.py) and builds its
# own libc++ from vendored LLVM source using that same clang, on every
# platform, regardless of host OS. This toolchain follows the same
# structure:
#
#   1. Chromium's actual current pinned clang/lld/llvm-ar/llvm-objcopy/
#      llvm-strip/llvm-nm (the exact same prebuilt package Chromium's own
#      build downloads -- see build/toolchain/setup_toolchain.sh for the
#      exact commit and download URL). Provides the compiler, linker, and
#      binutils-equivalents for every architecture from one binary.
#
#   2. libc++/libc++abi/libunwind, built from LLVM source at that same
#      commit, once per target architecture, by that same clang. This is
#      what actually makes constexpr std::vector (etc) support consistent
#      across architectures: it no longer depends on whatever libstdc++
#      version happens to ship with a given target's GCC cross-package.
#
#   3. glibc (headers, crt*.o, and -- unlike Chromium's own sysroot
#      tarballs, which are dynamic-linking-only and ship no static
#      libraries at all -- real .a static libraries), pinned to a fixed
#      Ubuntu archive snapshot (snapshot.ubuntu.com) rather than "whatever
#      apt has installed right now". This is the piece that actually
#      caused the mipsel breakage above; pinning it is what fixes it for
#      good, independent of which Ubuntu release happens to be running
#      the build.
#
# mipsel is the one exception to using compiler-rt for the runtime
# (libgcc.a/crtbeginS.o/libatomic.a instead): Chromium's clang package
# ships no compiler-rt at all for MIPS (Chromium/V8 dropped MIPS support
# in 2019), so mipsel still needs a real GCC's runtime pieces, pinned to
# the same snapshot as everything else rather than left as a live
# `apt install`. See setup_toolchain.sh for specifics.
#
# All of the download/build work happens in setup_toolchain.sh (run once
# per architecture before Bazel runs, in CI or locally), producing fixed
# paths (/opt/chromium-clang, /opt/libcxx-<arch>) that this BUILD file's
# tool_paths/compile_flags/link_flags reference directly -- the same
# "CI installs to a known path, Bazel hardcodes that path" pattern already
# used for the JDK/Python toolchains Bazel itself auto-configures.

load("@bazel_tools//tools/cpp:unix_cc_toolchain_config.bzl", "cc_toolchain_config")
load(
    ":toolchain_flags.bzl",
    "libcxx_compile_flags",
    "libcxx_link_flags",
    "libcxx_link_libs",
)

package(default_visibility = ["//visibility:public"])

filegroup(name = "empty")

CLANG = "/opt/chromium-clang/bin/clang"

LLVM_TOOL_PATHS = {
    "gcc": CLANG,
    "ld": "/opt/chromium-clang/bin/ld.lld",
    "ar": "/opt/chromium-clang/bin/llvm-ar",
    "cpp": CLANG,
    "gcov": "/bin/false",
    "nm": "/opt/chromium-clang/bin/llvm-nm",
    "objdump": "/opt/chromium-clang/bin/llvm-objdump",
    "strip": "/opt/chromium-clang/bin/llvm-strip",
}

# clang/lld's own resource-dir headers -- identical for every target,
# since it's one clang binary for all of them.
CLANG_BUILTIN_INCLUDES = [
    "/opt/chromium-clang/lib/clang/23/include",
    "/usr/local/include",
]

# --- x86_64 ---

platform(
    name = "linux_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

cc_toolchain_config(
    name = "x64_config",
    toolchain_identifier = "chromium-clang-x86_64-linux-gnu",
    host_system_name = "x86_64-unknown-linux-gnu",
    target_system_name = "x86_64-unknown-linux-gnu",
    cpu = "x86_64",
    target_libc = "glibc_unknown",
    compiler = "clang",
    abi_version = "clang",
    abi_libc_version = "glibc_unknown",
    tool_paths = LLVM_TOOL_PATHS,
    compile_flags = [
        "--target=x86_64-unknown-linux-gnu",
    ] + libcxx_compile_flags("x64"),
    link_flags = [
        "--target=x86_64-unknown-linux-gnu",
    ] + libcxx_link_flags("x64"),
    link_libs = libcxx_link_libs(),
    archive_flags = [],
    unfiltered_compile_flags = ["-no-canonical-prefixes"],
    opt_compile_flags = [
        "-g0",
        "-O2",
        "-D_FORTIFY_SOURCE=1",
        "-DNDEBUG",
        "-ffunction-sections",
        "-fdata-sections",
    ],
    opt_link_flags = ["-Wl,--gc-sections"],
    dbg_compile_flags = ["-g"],
    cxx_builtin_include_directories = CLANG_BUILTIN_INCLUDES + [
        "/opt/libcxx-x64/include/c++/v1",
        "/usr/include/x86_64-linux-gnu",
        "/usr/include",
    ],
)

cc_toolchain(
    name = "x64_toolchain",
    toolchain_identifier = "chromium-clang-x86_64-linux-gnu",
    toolchain_config = ":x64_config",
    all_files = ":empty",
    ar_files = ":empty",
    as_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 0,
)

toolchain(
    name = "x64_cc_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":x64_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)


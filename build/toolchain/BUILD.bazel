cc_toolchain(
    name = "aarch64_toolchain",
    toolchain_identifier = "chromium-clang-aarch64-linux-gnu",
    toolchain_config = ":aarch64_config",
    all_files = ":empty",
    ar_files = ":empty",
    as_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 0,

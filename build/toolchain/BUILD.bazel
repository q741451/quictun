# A from-scratch, pinned, Chromium-style cc_toolchain for all four
# architectures this project builds for (x86_64, aarch64, armv7, mipsel).
#
# This intentionally does NOT use Ubuntu's system/apt clang or gcc-*-cross
# packages as the compiler. Those drift across Ubuntu releases in ways
# that are invisible until they aren't: this project's mipsel toolchain
# broke once already because the GCC bundled with Ubuntu's mipsel cross
# package (GCC 10 on the Ubuntu release used for local dev) didn't support
# a C++20 constexpr std::vector that GCC 11+ does, and the real GitHub
# Actions runner (a different, newer Ubuntu release) silently had a
# different GCC version than local testing did.
#
# Chromium avoids this class of problem entirely by never depending on
# the host OS's own toolchain: it downloads a specific, hash-identified
# prebuilt clang (pinned in tools/clang/scripts/update.py) and builds its
# own libc++ from vendored LLVM source using that same clang, on every
# platform, regardless of host OS. This toolchain follows the same
# structure:
#
#   1. Chromium's actual current pinned clang/lld/llvm-ar/llvm-objcopy/
#      llvm-strip/llvm-nm (the exact same prebuilt package Chromium's own
#      build downloads -- see build/toolchain/setup_toolchain.sh for the
#      exact commit and download URL). Provides the compiler, linker, and
#      binutils-equivalents for every architecture from one binary.
#
#   2. libc++/libc++abi/libunwind, built from LLVM source at that same
#      commit, once per target architecture, by that same clang. This is
#      what actually makes constexpr std::vector (etc) support consistent
#      across architectures: it no longer depends on whatever libstdc++
#      version happens to ship with a given target's GCC cross-package.
#
#   3. musl, built from a checksum-pinned source tarball by that same
#      clang, used as the sysroot for both headers and static libraries.
#      This replaced a glibc pinned to an Ubuntu archive snapshot, which
#      worked but still meant the libc came from a distro. musl is smaller
#      (~25% off each stripped binary), ships rcrt1.o on every
#      architecture so -static-pie works uniformly, and removes the last
#      reason for this build to read anything out of /usr.
#
# musl ships no kernel UAPI headers (<linux/*>). quictun's own code needs
# none -- the few constants involved are defined inline behind
# __has_include guards -- and the three headers third-party dependencies
# include are shimmed by setup_toolchain.sh. Swapping libc silently changes
# which #if branches the preprocessor takes, which is how a
# __GLIBC_PREREQ-gated accept4 check ended up handing back blocking sockets;
# build/toolchain/libc_macro_audit.sh exists to enumerate that class of
# difference rather than rediscover it at runtime.
#
# mipsel is not wired up on this toolchain: Chromium's clang package ships
# no compiler-rt at all for MIPS (Chromium/V8 dropped MIPS support in 2019).
# The glibc toolchain borrowed libgcc from a gcc-mipsel-cross package, which
# is exactly the distro dependency this design removes, so mipsel needs
# compiler-rt built from source rather than a straight port.
#
# All of the download/build work happens in setup_toolchain.sh (run once
# per architecture before Bazel runs, in CI or locally), which writes the
# resolved install paths to toolchain_paths.bzl for the tool_paths /
# compile_flags / link_flags below to load -- the same "set up once, then
# reference a known path" pattern Bazel itself uses for JDK/Python
# toolchains, except the path is a working directory in the repo rather
# than a system location, so no step of this needs root.

load("@bazel_tools//tools/cpp:unix_cc_toolchain_config.bzl", "cc_toolchain_config")
load(":toolchain_paths.bzl", "CLANG_RESOURCE_DIR", "TOOLCHAIN_PREFIX")
load(
    ":toolchain_flags.bzl",
    "libcxx_compile_flags",
    "libcxx_link_flags",
    "libcxx_link_libs",
    "sysroot_flags",
)

package(default_visibility = ["//visibility:public"])

filegroup(name = "empty")

CLANG = TOOLCHAIN_PREFIX + "/chromium-clang/bin/clang"

LLVM_TOOL_PATHS = {
    "gcc": CLANG,
    "ld": TOOLCHAIN_PREFIX + "/chromium-clang/bin/ld.lld",
    "ar": TOOLCHAIN_PREFIX + "/chromium-clang/bin/llvm-ar",
    "cpp": CLANG,
    "gcov": "/bin/false",
    "nm": TOOLCHAIN_PREFIX + "/chromium-clang/bin/llvm-nm",
    "objdump": TOOLCHAIN_PREFIX + "/chromium-clang/bin/llvm-objdump",
    "strip": TOOLCHAIN_PREFIX + "/chromium-clang/bin/llvm-strip",
}

# clang/lld's own resource-dir headers -- identical for every target,
# since it's one clang binary for all of them.
# Deliberately just clang's own resource-dir headers: no /usr/local/include,
# no /usr/include. Everything else comes from the musl sysroot, so the build
# cannot silently pick anything up from the host.
CLANG_BUILTIN_INCLUDES = [
    CLANG_RESOURCE_DIR + "/include",
]

# --- x86_64 ---

platform(
    name = "linux_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

cc_toolchain_config(
    name = "x64_config",
    toolchain_identifier = "chromium-clang-x86_64-linux-gnu",
    host_system_name = "x86_64-unknown-linux-gnu",
    target_system_name = "x86_64-linux-musl",
    cpu = "x86_64",
    target_libc = "musl",
    compiler = "clang",
    abi_version = "clang",
    abi_libc_version = "musl",
    tool_paths = LLVM_TOOL_PATHS,
    compile_flags = [
        "--target=x86_64-linux-musl",
    ] + sysroot_flags("x64") + libcxx_compile_flags("x64"),
    link_flags = [
        "--target=x86_64-linux-musl",
    ] + sysroot_flags("x64") + libcxx_link_flags("x64"),
    link_libs = libcxx_link_libs(),
    archive_flags = [],
    unfiltered_compile_flags = ["-no-canonical-prefixes"],
    opt_compile_flags = [
        "-g0",
        "-O2",
        "-D_FORTIFY_SOURCE=1",
        "-DNDEBUG",
        "-ffunction-sections",
        "-fdata-sections",
    ],
    opt_link_flags = ["-Wl,--gc-sections"],
    dbg_compile_flags = ["-g"],
    cxx_builtin_include_directories = CLANG_BUILTIN_INCLUDES + [
        TOOLCHAIN_PREFIX + "/libcxx-x64/include/c++/v1",
        TOOLCHAIN_PREFIX + "/musl-x64/include",
    ],
)

cc_toolchain(
    name = "x64_toolchain",
    toolchain_identifier = "chromium-clang-x86_64-linux-gnu",
    toolchain_config = ":x64_config",
    all_files = ":empty",
    ar_files = ":empty",
    as_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 0,
)

toolchain(
    name = "x64_cc_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":x64_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)


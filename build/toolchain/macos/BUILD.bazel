# The macOS counterpart of build/toolchain/BUILD.bazel: Chromium's pinned
# clang (its Mac_arm64 package, same version as Linux) and a from-source
# static libc++, with Apple's SDK in place of the musl sysroot. See
# setup_toolchain_macos.sh for what is pinned to what, and toolchain_def.bzl
# here for the toolchain itself.
#
# A separate package rather than more entries in build/toolchain/BUILD.bazel,
# because each package loads a toolchain_paths.bzl that only its own setup
# script writes, and only on its own OS. The toolchains are registered from
# .bazelrc per host OS (build:linux / build:macos) instead of MODULE.bazel,
# so a build never loads the other OS's package and its missing paths file.

load(":toolchain_def.bzl", "macos_cc_toolchain")

package(default_visibility = ["//visibility:public"])

filegroup(name = "empty")

# One line per architecture, as in build/toolchain/BUILD.bazel: this repo's
# name for it (which keys MACOS_TARGETS, the --target table that
# setup_toolchain_macos.sh writes), cc_toolchain_config's `cpu`, and the
# @platforms//cpu: constraint.
[
    macos_cc_toolchain(
        arch = arch,
        cpu = cpu,
        bazel_cpu = bazel_cpu,
    )
    for (arch, cpu, bazel_cpu) in [
        ("arm64", "darwin_arm64", "aarch64"),
        ("x64", "darwin_x86_64", "x86_64"),
    ]
]

"""What a macOS target architecture's cc_toolchain looks like.

The counterpart of build/toolchain/toolchain_def.bzl, laid out the same way:
the four rules each architecture needs (platform, cc_toolchain_config,
cc_toolchain, toolchain) differ only in the values macos_cc_toolchain
takes, with Apple's SDK where Linux has the musl sysroot. Both architectures
are built on an Apple silicon Mac (exec_compatible_with below), x86_64 as a
cross build.

Adding an architecture: an entry in setup_toolchain_macos.sh's
arch_apple_arch, one macos_cc_toolchain() call, and one more name in
.bazelrc's build:macos --extra_toolchains.
"""

load(
    "@bazel_tools//tools/cpp:unix_cc_toolchain_config.bzl",
    "cc_toolchain_config",
)
load(
    ":toolchain_paths.bzl",
    "CLANG_RESOURCE_DIR",
    "MACOS_TARGETS",
    "SDK_PATH",
    "TOOLCHAIN_PREFIX",
)

CLANG_DIR = TOOLCHAIN_PREFIX + "/chromium-clang-mac"

# The Mac clang package has no llvm-nm or llvm-objdump; nothing in a normal
# build runs either, so they point at a tool that fails loudly if one ever is.
_TOOL_PATHS = {
    "gcc": CLANG_DIR + "/bin/clang",
    "ld": CLANG_DIR + "/bin/ld64.lld",
    "ar": CLANG_DIR + "/bin/llvm-ar",
    "cpp": CLANG_DIR + "/bin/clang",
    "gcov": "/usr/bin/false",
    "nm": "/usr/bin/false",
    "objdump": "/usr/bin/false",
    "strip": CLANG_DIR + "/bin/llvm-strip",
}

# The same -c opt compile set as Linux. -ffunction-sections/-fdata-sections
# come from .bazelrc on both; Mach-O ignores them, its linker dead-strips by
# atom instead.
_OPT_COMPILE_FLAGS = [
    "-g0",
    "-O2",
    "-D_FORTIFY_SOURCE=1",
    "-DNDEBUG",
]

# Each of Linux's opt link flags (build/toolchain/toolchain_def.bzl), as
# ld64.lld spells it. Like those, these only decide layout and duplicate
# elimination, never code generation.
#
#   --gc-sections            -> -dead_strip
#   --icf=safe               -> --icf=safe. It folds only functions the
#       object's __llvm_addrsig table says are not address-taken, and clang
#       emits that table by default for ELF but not Mach-O -- hence the
#       -faddrsig in compile_flags below. Without it lld treats every symbol
#       of such an object as address-taken and folds nothing.
#   -O2                      -> -O2, which on Mach-O compacts dyld's bind
#       opcodes, plus --tail-merge-strings, the string tail merging that
#       ELF's -O2 implies and Mach-O keeps behind its own flag.
#   -z pack-relative-relocs  -> none. Its Mach-O counterpart, chained fixups,
#       needs a dyld newer than macOS 11, which these binaries run on; lld
#       turns it on by itself only for a macOS 13 minimum
#       (lld/MachO/Driver.cpp, shouldEmitChainedFixups).
_OPT_LINK_FLAGS = [
    "-Wl,-dead_strip",
    "-Wl,--icf=safe",
    "-Wl,-O2",
    "-Wl,--tail-merge-strings",
]

def macos_cc_toolchain(arch, cpu, bazel_cpu):
    """Defines the platform + toolchain quartet for one macOS architecture.

    Args:
      arch: this repo's short name for the architecture (arm64, x64). Keys
        MACOS_TARGETS and names the libc++ directory setup_toolchain_macos.sh
        installs, so it has to match that script's arch_apple_arch().
      cpu: the value for cc_toolchain_config's `cpu` attribute.
      bazel_cpu: the @platforms//cpu: constraint this architecture selects on.
    """

    # Indexed, not .get(): a missing entry means toolchain_paths.bzl was
    # generated by an older setup_toolchain_macos.sh.
    target = MACOS_TARGETS[arch]
    libcxx = "%s/libcxx-macos-%s" % (TOOLCHAIN_PREFIX, arch)
    target_flags = ["--target=" + target, "-isysroot", SDK_PATH]

    native.platform(
        name = "macos_" + arch,
        constraint_values = [
            "@platforms//os:osx",
            "@platforms//cpu:" + bazel_cpu,
        ],
    )

    cc_toolchain_config(
        name = arch + "_config",
        toolchain_identifier = "chromium-clang-macos-" + arch,
        host_system_name = "arm64-apple-macos",
        target_system_name = target,
        cpu = cpu,
        target_libc = "macosx",
        compiler = "clang",
        abi_version = "clang",
        abi_libc_version = "macosx",
        tool_paths = _TOOL_PATHS,
        compile_flags = target_flags + [
            "-faddrsig",
            "-nostdinc++",
            "-isystem",
            libcxx + "/include/c++/v1",
        ],
        # -no_exported_symbols: a macOS executable otherwise exports every
        # global symbol to dyld, here the whole of the static libc++ -- for
        # quictun_client a 167KB export trie, plus the weak-binding entries
        # that exporting brings. quictun loads no plugins, so like a Linux
        # static-pie it exports nothing; lld documents the flag for exactly
        # this ("main executables that don't have plugins"), after ld64.
        link_flags = target_flags + [
            "-fuse-ld=lld",
            "-nostdlib++",
            "-Wl,-no_exported_symbols",
        ],
        # By full path, so the linker cannot resolve -lc++ to the SDK's
        # libc++.tbd instead.
        link_libs = [
            libcxx + "/lib/libc++.a",
            libcxx + "/lib/libc++abi.a",
        ],
        archive_flags = [],
        unfiltered_compile_flags = ["-no-canonical-prefixes"],
        opt_compile_flags = _OPT_COMPILE_FLAGS,
        opt_link_flags = _OPT_LINK_FLAGS,
        dbg_compile_flags = ["-g"],
        # The whole SDK, not just usr/include and Frameworks: clang reads
        # SDKSettings.json at the SDK root on every compile and lists it in
        # the .d file, and Bazel rejects any dependency outside these.
        cxx_builtin_include_directories = [
            CLANG_RESOURCE_DIR + "/include",
            libcxx + "/include/c++/v1",
            SDK_PATH,
        ],
    )

    native.cc_toolchain(
        name = arch + "_toolchain",
        toolchain_identifier = "chromium-clang-macos-" + arch,
        toolchain_config = ":" + arch + "_config",
        all_files = ":empty",
        ar_files = ":empty",
        as_files = ":empty",
        compiler_files = ":empty",
        dwp_files = ":empty",
        linker_files = ":empty",
        objcopy_files = ":empty",
        strip_files = ":empty",
        supports_param_files = 0,
    )

    native.toolchain(
        name = arch + "_cc_toolchain",
        exec_compatible_with = [
            "@platforms//os:osx",
            "@platforms//cpu:aarch64",
        ],
        target_compatible_with = [
            "@platforms//os:osx",
            "@platforms//cpu:" + bazel_cpu,
        ],
        toolchain = ":" + arch + "_toolchain",
        toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    )
